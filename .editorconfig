root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{bat,cmd,ps1}]
end_of_line = crlf

[*.ipynb]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,pdf,pkl,db}]
charset =
end_of_line =
insert_final_newline =
trim_trailing_whitespace =
